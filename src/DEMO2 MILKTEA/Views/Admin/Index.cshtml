@{
    ViewData["Title"] = "Trang quản trị";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px;
    }

    .admin-title {
        font-size: 28px;
        font-weight: bold;
        color: #e91e63;
        margin-bottom: 20px;
        text-align: center;
    }

    .admin-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .admin-card {
        background: #fff0f5;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        transition: 0.2s ease;
    }

        .admin-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.15);
        }

        .admin-card h3 {
            margin-bottom: 10px;
            color: #d81b60;
        }

        .admin-card a {
            display: inline-block;
            margin-top: 10px;
            padding: 10px 18px;
            background: #e91e63;
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
        }

            .admin-card a:hover {
                background: #c2185b;
            }
</style>

<div class="admin-container">
    <div class="admin-title">Trang quản trị hệ thống</div>

    <div class="admin-grid">
        <div class="admin-card">
            <h3>Quản lý sản phẩm</h3>
            <p>Thêm, sửa, xoá sản phẩm trà sữa</p>
            <a href="/AdminProduct/Index">Truy cập</a>
        </div>

        <div class="admin-card">
            <h3>Quản lý danh mục</h3>
            <p>Quản lý loại sản phẩm</p>
            <a href="/Product/Category">Truy cập</a>
        </div>

        <div class="admin-card">
            <h3>Quản lý đơn hàng</h3>
            <p>Xem và xử lý đơn đặt hàng</p>
            <a href="/AdminOrder/Index">Truy cập</a>
        </div>

       
    </div>
</div>
