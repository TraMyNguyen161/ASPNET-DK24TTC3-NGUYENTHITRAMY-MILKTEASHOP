@model IEnumerable<MILKTEASHOP.Models.Product>
@{
    ViewBag.Title = "Sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .card {
        background: #fff5f8;
        border: 1px solid #ffd0e3;
        border-radius: 16px;
        padding: 15px;
        text-align: center;
        box-shadow: 0 4px 10px rgba(255, 150, 180, 0.15);
        transition: 0.2s ease;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 18px rgba(255, 150, 180, 0.25);
        }

    .thumb img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        border-radius: 12px;
    }

    .muted {
        color: #777;
        margin-bottom: 6px;
    }

    .meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 12px;
    }

    .price {
        color: #e91e63;
        font-size: 18px;
        font-weight: bold;
    }

    .add {
        background: #ff7eb9;
        border: none;
        padding: 6px 12px;
        border-radius: 10px;
        color: white;
        cursor: pointer;
        transition: 0.2s;
    }

        .add:hover {
            background: #ff4f9a;
        }
    /* Sidebar */
    .sidebar {
        background: #fff0f5;
        padding: 15px;
        border-radius: 14px;
        border: 1px solid #ffc8dd;
    }

        .sidebar h3 {
            margin-bottom: 10px;
            font-size: 18px;
            color: #e91e63;
        }

        .sidebar ul {
            list-style: inside;
            padding: 0;
        }

            .sidebar ul li {
                margin: 8px 0;
            }

                .sidebar ul li a {
                    color: #d63384;
                    text-decoration: none;
                    font-weight: 500;
                }

                    .sidebar ul li a:hover {
                        color: #ff4fa3;
                    }
</style>
<h2></h2>


<div class="product-layout">

    <!-- ==== SIDEBAR ==== -->
    <aside class="sidebar">
        <h3>Danh mục sản phẩm</h3>
        <ul>
            @foreach (var cat in ViewBag.Categories)
            {
                <li>
                    <a href="/Product/Category/@cat.CategoryId">
                        @cat.CategoryName
                    </a>
                </li>
            }
        </ul>
    </aside>

    <!-- ==== DANH SÁCH SẢN PHẨM ==== -->
    <div class="grid">
        @foreach (var item in Model)
        {
            <div class="card">
                <div class="thumb">
                    <a href="/Product/Detail/@item.ProductId">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/150" : item.ImageUrl)" />
                    </a>
                </div>
                <div>
                    <div style="font-weight:700">@item.ProductName</div>
                    <div class="muted" style="font-size:13px">@item.Category?.CategoryName</div>
                </div>
                <!-- mô tả -->
                <div class="muted" style="font-size:12px; max-height:40px; overflow:hidden; text-overflow:ellipsis;">
                    @item.Description
                </div>
                <div class="meta">
                    <div class="price">@item.BasePrice.ToString("#,##0")₫</div>
                    <a href="/Cart/Add/@item.ProductId" class="add" style="display:inline-block; text-decoration:none;">
    Thêm
</a>
                </div>
                <!-- Nút Mua ngay -->
                <a href="@Url.Action("Create", "Order", new { productId = item.ProductId })"
                   class="add" style="display:inline-block; background:#ff4f9a;">
                    Mua ngay
                </a>
            </div>
        }
    </div>

</div>
<script>
    const searchInput = document.getElementById("searchInput");
    const allCards = document.querySelectorAll(".card");

    searchInput.addEventListener("input", function () {
        const keyword = this.value.toLowerCase();

        allCards.forEach(card => {
            const name = card.querySelector("div[style*='font-weight']").innerText.toLowerCase();
            const category = card.querySelector(".muted").innerText.toLowerCase();
            const desc = card.querySelector("div.muted:nth-of-type(2)")?.innerText.toLowerCase() || "";

            // Nếu tên hoặc mô tả chứa keyword → show
            if (name.includes(keyword) || category.includes(keyword) || desc.includes(keyword)) {
                card.style.display = "block";
            } else {
                card.style.display = "none";
            }
        });
    });
</script>

