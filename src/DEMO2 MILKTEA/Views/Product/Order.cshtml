@model MILKTEASHOP.Models.Order
@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .order-container {
        display: flex;
        gap: 20px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .order-form {
        flex: 1;
        min-width: 300px;
        background: #fff0f5;
        padding: 20px;
        border-radius: 14px;
    }

    .cart-summary {
        flex: 1;
        min-width: 300px;
        background: #ffe9f0;
        padding: 20px;
        border-radius: 14px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 5px;
        color: #d63384;
    }

    input, textarea, select {
        width: 100%;
        padding: 8px;
        border-radius: 8px;
        border: 1px solid #ffc8dd;
    }

    .btn-submit {
        background: #ff5aa3;
        color: white;
        font-weight: 700;
        padding: 10px 16px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
    }

        .btn-submit:hover {
            background: #ff297a;
        }

    .cart-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #ffd0e3;
    }
</style>

<h2>Thông tin đặt hàng</h2>

<div class="order-container">

    <!-- Form khách hàng -->
    <div class="order-form">
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label>Tên khách</label>
                <input asp-for="CustomerName" required />
            </div>
            <div class="form-group">
                <label>Số điện thoại</label>
                <input asp-for="PhoneNumber" required />
            </div>
            <div class="form-group">
                <label>Địa chỉ giao hàng</label>
                <textarea asp-for="ShippingAddress" required></textarea>
            </div>

            <h4>Sản phẩm trong giỏ</h4>
            <div id="cartItems"></div>

            <button type="submit" class="btn-submit">Xác nhận đặt hàng</button>
        </form>
    </div>

