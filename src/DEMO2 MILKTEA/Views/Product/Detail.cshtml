@model MILKTEASHOP.Models.Product
@{
    ViewBag.Title = Model.ProductName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Ảnh & thông tin SP -->
<div style="display:flex;gap:32px;align-items:flex-start;flex-wrap:wrap;margin-top:20px">

    <!-- Ảnh sản phẩm -->
    <div style="flex:1;min-width:300px;">
        <div style="
            width:100%;
            border-radius:16px;
            background:linear-gradient(180deg,#ffe9f0,#ffd0e3);
            padding:20px;
            text-align:center;
            box-shadow:0 8px 20px rgba(255,130,170,0.12);
        ">
            <img src="@(Model.ImageUrl ?? "https://via.placeholder.com/400")"
                 style="max-width:100%;max-height:360px;object-fit:contain;" />
        </div>
    </div>

    <!-- Thông tin -->
    <div style="flex:1;min-width:300px;">
        <h2 style="margin:0 0 8px 0;font-size:32px;font-weight:700;">
            @Model.ProductName
        </h2>

        <div class="muted" style="font-size:14px;margin-bottom:12px">
            @(Model.Category?.CategoryName ?? "Thơm ngon mỗi ngày")
        </div>

        <div style="font-size:28px;font-weight:800;color:#ff5aa3;margin-bottom:16px">
            @Model.BasePrice.ToString("#,##0")₫
        </div>

        <!-- Chọn số lượng -->
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px">
            <button onclick="changeQty(-1)"
                    style="padding:8px 12px;border-radius:10px;border:none;background:#ffd0e3;cursor:pointer">
                -
            </button>

            <div id="qtyBox"
                 style="padding:8px 16px;background:white;border-radius:10px;box-shadow:0 2px 6px rgba(0,0,0,0.05)">
                1
            </div>

            <button onclick="changeQty(1)"
                    style="padding:8px 12px;border-radius:10px;border:none;background:#ff97c1;color:white;cursor:pointer">
                +
            </button>
        </div>

        <a asp-controller="Cart"
           asp-action="Add"
           asp-route-id="@Model.ProductId"
           class="add"
           style="
        padding:12px 20px;
        background:linear-gradient(90deg,#ff97c1,#ff5aa3);
        border:none;
        border-radius:12px;
        color:white;
        font-size:16px;
        font-weight:700;
        display:inline-block;
        cursor:pointer;
        text-decoration:none;
   ">
            Thêm vào giỏ hàng
        </a>

        <!-- Mô tả -->
        @if (!string.IsNullOrEmpty(Model.Description))
        {

            <div style="margin-top:40px">
                <h3>Mô tả sản phẩm</h3>
                <p style="line-height:1.6;color:#555">@Model.Description</p>
            </div>
        }

    </div>

</div>



<!-- Sản phẩm liên quan -->
@if (ViewBag.Related != null)
{
    <h3 style="margin-top:40px">Sản phẩm liên quan</h3>
        <div class="grid" style="
                display:grid;
                grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
                gap:16px;
                
            ">
            <style>
            .card {
                background: #fff5f8;
                border: 1px solid #ffd0e3;
                border-radius: 16px;
                padding: 15px;
                text-align: center;
                box-shadow: 0 4px 10px rgba(255, 150, 180, 0.15);
                transition: 0.2s ease;
            }

                .card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 8px 18px rgba(255, 150, 180, 0.25);
                }

            .thumb img {
                width: 100%;
                height: 160px;
                object-fit: cover;
                border-radius: 12px;
            }
            .muted {
        color: #777;
        margin-bottom: 6px;
    }

    .meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 12px;
    }

    .price {
        color: #e91e63;
        font-size: 18px;
        font-weight: bold;
    }

    .add {
        background: #ff7eb9;
        border: none;
        padding: 6px 12px;
        border-radius: 10px;
        color: white;
        cursor: pointer;
        transition: 0.2s;
    }

        .add:hover {
            background: #ff4f9a;
        }
            </style>
        @foreach (var item in (List<MILKTEASHOP.Models.Product>)ViewBag.Related)
        {
            <div class="card">
                <div class="thumb">
                    <img src="@item.ImageUrl" alt="@item.ProductName"
                         style="max-height:140px;object-fit:contain" />
                </div>

                <div>
                    <div style="font-weight:700">@item.ProductName</div>
                    <div class="muted" style="font-size:13px">@item.Category?.CategoryName</div>
                </div>

                <div class="meta">
                    <div class="price">@item.BasePrice.ToString("#,##0")₫</div>
                    <a href="/Product/Detail/@item.ProductId"
                       class="add"
                       style="text-decoration:none;display:inline-block;padding:8px 12px">
                        Xem
                    </a>
                </div>
            </div>
                             }
    </div>
}

<script>
    let qty = 1;

    function changeQty(val){
        qty = Math.max(1, qty + val);
        document.getElementById("qtyBox").textContent = qty;
    }

    function addDetailToCart(id){
        // cart từ localStorage trong layout
        let cart = JSON.parse(localStorage.getItem("pinkCart") || "{}");
        cart[id] = (cart[id] || 0) + qty;
        localStorage.setItem("pinkCart", JSON.stringify(cart));

        alert("Đã thêm vào giỏ hàng");
    }
</script>
