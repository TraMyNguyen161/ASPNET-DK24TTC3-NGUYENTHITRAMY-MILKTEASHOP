@model List<MILKTEASHOP.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
    var allToppings = ViewBag.Toppings as List<MILKTEASHOP.Models.Topping>;
}

<style>
    .cart-wrapper {
        width: 100%;
        max-width: 1600px;
        margin: 40px auto;
        background: #fff0f6;
        padding: 25px 40px;
        border-radius: 16px;
        box-shadow: 0 4px 10px #ffb6d680;
        border: 2px solid #ff9fcf;
        overflow-x: auto;
    }

    .cart-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #d63384;
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1000px;
    }

        table th {
            background: #ffd6e9;
            padding: 12px;
            font-size: 16px;
            color: #b31266;
            border-bottom: 2px solid #ffa3ce;
            text-align: left;
        }

        table td {
            padding: 12px;
            vertical-align: middle;
            border-bottom: 1px dashed #ffb6d6;
            font-size: 15px;
        }

    .remove-btn {
        color: white;
        background: #ff5c8a;
        padding: 6px 12px;
        border-radius: 8px;
        text-decoration: none;
        transition: 0.2s;
        font-size: 14px;
    }

        .remove-btn:hover {
            background: #ec407a;
        }

    .empty-cart {
        text-align: center;
        font-size: 18px;
        padding: 30px;
        color: #d63384;
    }

    .total-box {
        text-align: right;
        margin-top: 20px;
        padding: 15px;
        font-size: 20px;
        background: #ffe3ef;
        border-radius: 12px;
        border: 2px solid #ffb6d6;
        color: #b31266;
    }

    .checkout-btn {
        display: block;
        margin: 20px auto 0;
        padding: 12px 25px;
        text-align: center;
        background: #ff66a3;
        color: white;
        border-radius: 14px;
        font-size: 18px;
        width: 200px;
        text-decoration: none;
        box-shadow: 0 3px 8px #ff8ec580;
        transition: 0.2s;
    }

        .checkout-btn:hover {
            background: #ff4d94;
        }

    .topping-box {
        background: #fff7fb;
        padding: 10px;
        border-radius: 12px;
        border: 1px solid #ffc0dc;
        margin-top: 8px;
        max-height: 150px;
        overflow-y: auto;
    }

        .topping-box label {
            display: block;
            font-size: 14px;
            color: #b31266;
        }

    select {
        padding: 4px 8px;
        border-radius: 6px;
        border: 1px solid #ffb6d6;
    }
</style>

<div class="cart-wrapper">
    <div class="cart-title">@ViewData["Title"]</div>

    @if (Model == null || !Model.Any())
    {
        <p class="empty-cart">Giỏ hàng đang trống. Hãy thêm sản phẩm nhé! 💗</p>
    }
    else
    {
        <table> <div class="cart-list">
        @for (int i = 0; i < Model.Count; i++)
        {
                var item = Model[i];
                <div class="cart-item" data-index="@i" data-price="@item.Price">
                    <div class="cart-header">
                        <h3>@item.ProductName</h3>
                        <a class="remove-btn" asp-controller="Cart" asp-action="Remove" asp-route-id="@item.ProductId">Xóa</a>
                    </div>

                    <p class="price">Giá: @item.Price.ToString("C")</p>
                    <p class="qty">SL: @item.Quantity</p>

                    <div class="cart-row">
                        <strong>Topping:</strong>
                        <div class="topping-box">
                            @foreach (var t in allToppings)
                            {
                                    var isChecked = item.SelectedToppingIds != null && item.SelectedToppingIds.Contains(t.ToppingId);
                                    <label>
                                        <input type="checkbox" class="topping-checkbox"
                                               data-topping-price="@t.Price"
                                               data-item-index="@i"
                                               value="@t.ToppingId" @(isChecked ? "checked" : "") />
                                        @t.ToppingName (@t.Price.ToString("C"))
                                    </label>
                            }
                        </div>
                    </div>

                    <div class="cart-options">
                        <div>
                            <label>Size:</label>
                            <select class="size-select" data-product-id="@item.ProductId">
                                <option value="S" selected="@(item.Size == "S")">S</option>
                                <option value="M" selected="@(item.Size == "M")">M</option>
                                <option value="L" selected="@(item.Size == "L")">L</option>
                            </select>
                        </div>

                        <div>
                            <label>Đường:</label>
                            <select class="sugar-select" data-product-id="@item.ProductId">
                                <option value="100" selected="@(item.SugarLevel == 100)">100</option>
                                <option value="70" selected="@(item.SugarLevel == 70)">70</option>
                                <option value="50" selected="@(item.SugarLevel == 50)">50</option>
                            </select>
                        </div>

                        <div>
                            <label>Đá:</label>
                            <select class="ice-select" data-product-id="@item.ProductId">
                                <option value="100" selected="@(item.IceLevel == 100)">100</option>
                                <option value="50" selected="@(item.IceLevel == 50)">50</option>
                                <option value="0" selected="@(item.IceLevel == 0)">0</option>
                            </select>
                        </div>
                    </div>

                    <p class="subtotal-row">
                        <strong>Tạm tính: </strong>
                        <span class="subtotal"></span>
                    </p>
                </div>
        }
    </div>

        </table>

        <div class="total-box">
            <strong>Tổng tiền: </strong><span id="cartTotal"></span>
        </div>

        <a class="checkout-btn" href="@Url.Action("Create", "Order")">Thanh toán</a>
    }
</div>

<script>
    function updateCartTotals() {
        let total = 0;

        document.querySelectorAll('.cart-item').forEach(item => {
            const price = parseFloat(item.dataset.price);
            const qty = parseInt(item.querySelector('.qty').innerText.replace("SL: ", ""));
            let toppingTotal = 0;

            item.querySelectorAll('.topping-checkbox').forEach(cb => {
                if (cb.checked)
                    toppingTotal += parseFloat(cb.dataset.toppingPrice);
            });

            const subtotal = (price * qty) + toppingTotal;

            item.querySelector('.subtotal').innerText =
                subtotal.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });

            total += subtotal;
        });

        document.getElementById('cartTotal').innerText =
            total.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });
    }

    // Topping event
    document.querySelectorAll('.topping-checkbox').forEach(cb => {
        cb.addEventListener('change', updateCartTotals);
    });

    // Size update
    document.querySelectorAll('.size-select').forEach(select => {
        select.addEventListener('change', function () {
            const productId = this.dataset.productId;
            const size = this.value;

            fetch('/Cart/UpdateSize', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId, size })
            }).then(updateCartTotals);
        });
    });

    // Sugar update
    document.querySelectorAll('.sugar-select').forEach(select => {
        select.addEventListener('change', function () {
            const productId = this.dataset.productId;
            const sugar = this.value;

            fetch('/Cart/UpdateSugar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId, sugar })
            }).then(updateCartTotals);
        });
    });

    // Ice update
    document.querySelectorAll('.ice-select').forEach(select => {
        select.addEventListener('change', function () {
            const productId = this.dataset.productId;
            const ice = this.value;

            fetch('/Cart/UpdateIce', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId, ice })
            }).then(updateCartTotals);
        });
    });

    updateCartTotals();
</script>
