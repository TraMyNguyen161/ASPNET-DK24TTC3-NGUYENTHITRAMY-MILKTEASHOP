@model List<MILKTEASHOP.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
    var allToppings = ViewBag.Toppings as List<MILKTEASHOP.Models.Topping>;
}

<div class="cart-wrapper">
    <h2 class="cart-title">Giỏ hàng của bạn</h2>

    @if (Model == null || !Model.Any())
    {
        <p class="empty-cart">Giỏ hàng đang trống. Hãy thêm sản phẩm nhé!</p>
    }
    else
    {
        <form method="post" action="/Cart/UpdateToppings">
            <table id="cartTable">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Giá</th>
                        <th>SL</th>
                        <th>Tạm tính</th>
                        <th>Topping</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        <tr data-index="@i" data-price="@item.Price">
                            <td>
                                <strong>@item.ProductName</strong>
                                <input type="hidden" name="CartItems[@i].ProductId" value="@item.ProductId" />
                            </td>
                            <td>@item.Price.ToString("N0") đ</td>
                            <td>@item.Quantity</td>
                            <td class="subtotal"></td>

                            <td>
                                <div class="topping-box">
                                    @foreach (var t in allToppings)
                                    {
                                        var isChecked = item.SelectedToppingIds != null && item.SelectedToppingIds.Contains(t.ToppingId);
                                        <label>
                                            <input type="checkbox" class="topping-checkbox"
                                                   name="CartItems[@i].SelectedToppingIds"
                                                   value="@t.ToppingId" @(isChecked ? "checked" : "")
                                                   data-topping-price="@t.Price" />
                                            @t.ToppingName (+@t.Price.ToString("N0") đ)
                                        </label>
                                    }
                                </div>
                            </td>

                            <td>
                                <a class="remove-btn" href="/Cart/Remove/@item.ProductId">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="total-box">
                <strong>Tổng tiền: </strong><span id="cartTotal"></span>
            </div>

            <button type="submit" class="update-btn">Cập nhật topping</button>
        </form>

        <a class="checkout-btn" href="/Order/Create">Thanh toán</a>
    }
</div>

<style>
    .cart-wrapper {
        max-width: 900px;
        margin: 40px auto;
        background: #fff0f6;
        padding: 25px;
        border-radius: 16px;
    }

    .cart-title {
        text-align: center;
        font-size: 28px;
        margin-bottom: 20px;
        color: #d63384;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #ffd6e9;
        padding: 10px;
        color: #b31266;
        border-bottom: 2px solid #ffa3ce;
    }

    td {
        padding: 12px;
        border-bottom: 1px dashed #ffb6d6;
    }

    .topping-box {
        background: #fff7fb;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #ffc0dc;
    }

    .topping-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px;
        background: #fff5f8;
        border-radius: 10px;
        border: 1px solid #ffb6c7;
    }

    .remove-btn {
        background: #ff5c8a;
        color: white;
        padding: 6px 10px;
        border-radius: 6px;
        text-decoration: none;
    }

    .total-box {
        text-align: right;
        margin-top: 20px;
        font-size: 20px;
    }

    .checkout-btn {
        display: block;
        background: #ff66a3;
        color: white;
        padding: 12px;
        width: 200px;
        margin: 20px auto;
        text-align: center;
        border-radius: 10px;
    }

    .update-btn {
        background: #ff9fcb;
        padding: 10px 16px;
        border-radius: 10px;
        margin-top: 15px;
        border: none;
    }
</style>

<script>
    function updateCartTotals() {
        let total = 0;
        document.querySelectorAll('#cartTable tbody tr').forEach(tr => {
            const price = parseFloat(tr.dataset.price);
            const qty = parseInt(tr.children[2].innerText);
            let toppingTotal = 0;

            tr.querySelectorAll('.topping-checkbox').forEach(cb => {
                if (cb.checked) toppingTotal += parseFloat(cb.dataset.toppingPrice);
            });

            const subtotal = (price * qty) + toppingTotal;
            tr.querySelector('.subtotal').innerText = subtotal.toLocaleString('vi-VN') + ' đ';
            total += subtotal;
        });

        document.getElementById('cartTotal').innerText = total.toLocaleString('vi-VN') + ' đ';
    }

    document.querySelectorAll('.topping-checkbox').forEach(cb => {
        cb.addEventListener('change', updateCartTotals);
    });

    updateCartTotals();
</script>