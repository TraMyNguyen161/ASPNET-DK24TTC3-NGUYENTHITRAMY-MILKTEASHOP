@model List<MILKTEASHOP.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
    var allToppings = ViewBag.Toppings as List<MILKTEASHOP.Models.Topping>;
}

<style>
    .cart-wrapper {
        width: 90%;
        max-width: 1500px;
        margin: 40px auto;
        background: #fff0f6;
        padding: 25px 40px;
        border-radius: 16px;
        box-shadow: 0 4px 10px #ffb6d680;
        border: 2px solid #ff9fcf;
    }


    .cart-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #d63384;
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

        table th {
            background: #ffd6e9;
            padding: 12px;
            font-size: 16px;
            color: #b31266;
            border-bottom: 2px solid #ffa3ce;
            text-align: left;
        }

        table td {
            padding: 12px;
            vertical-align: middle;
            border-bottom: 1px dashed #ffb6d6;
            font-size: 15px;
        }

    .remove-btn {
        color: white;
        background: #ff5c8a;
        padding: 6px 12px;
        border-radius: 8px;
        text-decoration: none;
        transition: 0.2s;
        font-size: 14px;
    }

        .remove-btn:hover {
            background: #ec407a;
        }

    .empty-cart {
        text-align: center;
        font-size: 18px;
        padding: 30px;
        color: #d63384;
    }

    .total-box {
        text-align: right;
        margin-top: 20px;
        padding: 15px;
        font-size: 20px;
        background: #ffe3ef;
        border-radius: 12px;
        border: 2px solid #ffb6d6;
        color: #b31266;
    }

    .checkout-btn {
        display: block;
        margin: 20px auto 0;
        padding: 12px 25px;
        text-align: center;
        background: #ff66a3;
        color: white;
        border-radius: 14px;
        font-size: 18px;
        width: 200px;
        text-decoration: none;
        box-shadow: 0 3px 8px #ff8ec580;
        transition: 0.2s;
    }

        .checkout-btn:hover {
            background: #ff4d94;
        }

    .topping-box {
        background: #fff7fb;
        padding: 10px;
        border-radius: 12px;
        border: 1px solid #ffc0dc;
        margin-top: 8px;
    }

        .topping-box label {
            display: block;
            font-size: 14px;
            color: #b31266;
        }
</style>

<div class="cart-wrapper">
    <div class="cart-title">@ViewData["Title"]</div>

    @if (Model == null || !Model.Any())
    {
        <p class="empty-cart">Giỏ hàng đang trống. Hãy thêm sản phẩm nhé! 💗</p>
    }
    else
    {
        <table id="cartTable">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Giá</th>
                    <th>SL</th>
                    <th>Tạm tính</th>
                    <th>Topping</th>
                    <th>Size</th>
                    <th>Đường</th>
                    <th>Đá</th>

                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    <tr data-index="@i" data-price="@item.Price">
                        <td>@item.ProductName</td>
                        <td>@item.Price.ToString("C")</td>
                        <td>@item.Quantity</td>
                        <td>@item.Size</td>
                        <td>@item.SugarLevel</td>
                        <td>@item.IceLevel</td>

                        <td class="subtotal"></td>
                        <td>
                            <div class="topping-box">
                                @foreach (var t in allToppings)
                                {
                                    var isChecked = item.SelectedToppingIds != null && item.SelectedToppingIds.Contains(t.ToppingId);
                                    <label>
                                        <input type="checkbox" class="topping-checkbox"
                                               data-topping-price="@t.Price"
                                               data-item-index="@i"
                                               value="@t.ToppingId" @(isChecked ? "checked" : "") />
                                        @t.ToppingName (@t.Price.ToString("C"))
                                    </label>
                                }
                            </div>
                        </td>
                        <td>
                            <a class="remove-btn" asp-controller="Cart" asp-action="Remove" asp-route-id="@item.ProductId">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="total-box">
            <strong>Tổng tiền: </strong><span id="cartTotal"></span>
        </div>

        <a class="checkout-btn" href="@Url.Action("Create", "Order")">Thanh toán</a>
    }
</div>

<script>
    function updateCartTotals() {
        let total = 0;
        document.querySelectorAll('#cartTable tbody tr').forEach(tr => {
            const price = parseFloat(tr.dataset.price);
            const qty = parseInt(tr.children[2].innerText);
            let toppingTotal = 0;

            tr.querySelectorAll('.topping-checkbox').forEach(cb => {
                if(cb.checked) toppingTotal += parseFloat(cb.dataset.toppingPrice);
            });

            const subtotal = (price * qty) + toppingTotal;
            tr.querySelector('.subtotal').innerText = subtotal.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });
            total += subtotal;
        });

        document.getElementById('cartTotal').innerText = total.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });
    }

    document.querySelectorAll('.topping-checkbox').forEach(cb => {
        cb.addEventListener('change', updateCartTotals);
    });

    updateCartTotals();
</script>
