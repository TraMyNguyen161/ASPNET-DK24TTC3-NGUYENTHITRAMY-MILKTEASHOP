@model IEnumerable<MILKTEASHOP.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
}

<style>
    .cart-wrapper {
        max-width: 900px;
        margin: 40px auto;
        background: #fff0f6;
        padding: 25px 30px;
        border-radius: 16px;
        box-shadow: 0 4px 10px #ffb6d680;
        border: 2px solid #ff9fcf;
    }

    .cart-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #d63384;
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

        table th {
            background: #ffd6e9;
            padding: 12px;
            font-size: 16px;
            color: #b31266;
            border-bottom: 2px solid #ffa3ce;
            text-align: left;
        }

        table td {
            padding: 12px;
            vertical-align: middle;
            border-bottom: 1px dashed #ffb6d6;
            font-size: 15px;
        }

    .remove-btn {
        color: white;
        background: #ff5c8a;
        padding: 6px 12px;
        border-radius: 8px;
        text-decoration: none;
        transition: 0.2s;
        font-size: 14px;
    }

        .remove-btn:hover {
            background: #ec407a;
        }

    .empty-cart {
        text-align: center;
        font-size: 18px;
        padding: 30px;
        color: #d63384;
    }

    .total-box {
        text-align: right;
        margin-top: 20px;
        padding: 15px;
        font-size: 20px;
        background: #ffe3ef;
        border-radius: 12px;
        border: 2px solid #ffb6d6;
        color: #b31266;
    }

    .checkout-btn {
        display: block;
        margin: 20px auto 0;
        padding: 12px 25px;
        text-align: center;
        background: #ff66a3;
        color: white;
        border-radius: 14px;
        font-size: 18px;
        width: 200px;
        text-decoration: none;
        box-shadow: 0 3px 8px #ff8ec580;
        transition: 0.2s;
    }

        .checkout-btn:hover {
            background: #ff4d94;
        }
</style>

<div class="cart-wrapper">
    <div class="cart-title">@ViewData["Title"]</div>

    @if (Model == null || !Model.Any())
    {
        <p class="empty-cart">Giỏ hàng đang trống. Hãy thêm sản phẩm nhé! 💗</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Giá</th>
                    <th>SL</th>
                    <th>Tạm tính</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Price.ToString("C")</td>
                        <td>@item.Quantity</td>
                        <td>@(item.Price* item.Quantity)</td>
                        <td>
                            <a class="remove-btn"
                               asp-controller="Cart"
                               asp-action="Remove"
                               asp-route-id="@item.ProductId">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="total-box">
            <strong>Tổng tiền: </strong>
            @Model.Sum(x => x.Price * x.Quantity).ToString("C")
        </div>

        <a class="checkout-btn" href="#">
            Thanh toán
        </a>
    }
</div>
