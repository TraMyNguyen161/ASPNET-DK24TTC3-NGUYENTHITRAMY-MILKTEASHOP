@{
    ViewData["Title"] = "Uống trà sữa không tăng cân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .news-container {
        max-width: 900px;
        margin: 40px auto;
        background: linear-gradient(135deg, #fff5f9, #ffffff);
        border-radius: 24px;
        padding: 35px;
        box-shadow: 0 15px 40px rgba(255, 90, 160, 0.12);
        font-family: 'Segoe UI', sans-serif;
        animation: fadeIn 0.5s ease-in-out;
    }

    .news-title {
        font-size: 34px;
        font-weight: 800;
        color: #ff5aa0;
        text-align: center;
        margin-bottom: 10px;
    }

    .news-subtitle {
        text-align: center;
        color: #888;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .news-image {
        width: 100%;
        max-height: 420px;
        object-fit: cover;
        border-radius: 20px;
        margin: 20px 0;
    }

    .news-content {
        font-size: 18px;
        line-height: 1.9;
        color: #444;
        text-align: justify;
    }

    .back-btn {
        display: inline-block;
        margin-top: 35px;
        padding: 12px 28px;
        background: #ff5aa0;
        color: white;
        border-radius: 999px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 10px 20px rgba(255,90,160,0.3);
        transition: 0.2s ease;
    }

        .back-btn:hover {
            background: #ff3f8e;
            transform: translateY(-2px);
        }
</style>
<div class="news-container">
    <div class="news-title">Uống trà sữa thế nào để không lo tăng cân?</div>
    <img src="https://i.imgur.com/zHhN4cR.jpeg" class="news-image" />

    <div class="news-content">
        Trà sữa là thức uống yêu thích của rất nhiều người, tuy nhiên không ít người lo lắng về việc tăng cân.
        Tin vui là bạn hoàn toàn có thể thưởng thức trà sữa một cách khoa học và lành mạnh.

        <br /><br />
        Hãy giảm lượng đường và đá, ưu tiên chọn sữa ít béo và hạn chế topping nhiều calo như kem cheese hoặc pudding.
        Ngoài ra, bạn nên uống trà sữa vào ban ngày thay vì buổi tối để cơ thể dễ dàng tiêu hao năng lượng.

        <br /><br />
        Chỉ cần một vài điều chỉnh nhỏ, bạn vẫn có thể tận hưởng trà sữa mà không ảnh hưởng đến vóc dáng.
    </div>
</div>
<div>

<a href="/News/Index" class="back-btn">← Quay lại Tin tức</a>
</div>
