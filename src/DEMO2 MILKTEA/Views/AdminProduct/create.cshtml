@model MILKTEASHOP.Models.Product
@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<style>
    .form-container {
        max-width: 600px;
        margin: 60px auto;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        padding: 30px 40px;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        border: 2px solid #ffc1d6;
        animation: fadeIn .5s ease;
    }

    .form-title {
        text-align: center;
        font-size: 28px;
        color: #d63384;
        font-weight: 700;
        margin-bottom: 20px;
    }

        .form-title span {
            font-size: 18px;
            color: #ff8fb1;
        }

    label {
        font-weight: 600;
        color: #d63384;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    input, textarea, select {
        width: 100%;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid #ffb6cf;
        margin-top: 4px;
        font-size: 15px;
    }

        input:focus, textarea:focus, select:focus {
            border-color: #ff5c8d;
            box-shadow: 0 0 5px #ffb3c9;
        }

    .btn-pink {
        background: #ff5c8d;
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        border: none;
        font-size: 16px;
        font-weight: 600;
        transition: .25s;
    }

        .btn-pink:hover {
            background: #d63384;
        }

    .btn-back {
        color: #d63384;
        font-weight: 600;
        margin-left: 10px;
    }

    @@keyframes fadeIn {


    {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>


<div class="form-container">

    <div class="form-title">
        <span>✦</span> Thêm Sản Phẩm Mới <span>✦</span>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">

        <div class="mb-4">
            <label>🌸 Tên sản phẩm</label>
            <input asp-for="ProductName" />
            <span asp-validation-for="ProductName" class="text-red-500"></span>
        </div>

        <div class="mb-4">
            <label>💰 Giá cơ bản</label>
            <input asp-for="BasePrice" type="number" step="0.01" />
        </div>

        <div class="mb-4">
            <label>📂 Danh mục</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories"></select>
        </div>

        <div class="mb-4">
            <label>📝 Mô tả</label>
            <textarea asp-for="Description" rows="4"></textarea>
        </div>

        <div class="mb-4">
            <label>🖼️ Hình ảnh sản phẩm</label>
            <input type="file" name="imageFile" />
        </div>

        <div class="mb-4 flex items-center gap-2">
            <input asp-for="IsActive" type="checkbox" style="width: 18px; height: 18px;" />
            <label>Kích hoạt</label>
        </div>

        <button type="submit" class="btn-pink">💾 Lưu sản phẩm</button>
        <a href="/AdminProduct/Index" class="btn-back">← Quay lại</a>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
