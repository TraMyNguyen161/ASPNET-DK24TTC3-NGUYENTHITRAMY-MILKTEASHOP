@model MILKTEASHOP.Models.Product
@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<style>
    body {
        background: #f8f9fb;
        font-family: 'Segoe UI', sans-serif;
    }

    .edit-container {
        max-width: 800px;
        margin: 30px auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        padding: 32px;
    }

    .edit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        border-bottom: 2px solid #ffe3ec;
        padding-bottom: 15px;
    }

        .edit-header h2 {
            font-size: 26px;
            color: #d6336c;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .back-link {
        text-decoration: none;
        color: #d6336c;
        font-weight: 600;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        font-size: 14px;
        color: #444;
    }

    input[type="text"],
    input[type="number"],
    select,
    textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1.5px solid #ddd;
        border-radius: 10px;
        font-size: 14px;
        transition: 0.2s ease;
    }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: #d6336c;
            outline: none;
            box-shadow: 0 0 0 3px rgba(214, 51, 108, 0.08);
        }

    textarea {
        resize: vertical;
        min-height: 90px;
    }

    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        font-weight: 600;
        color: #444;
    }

    .image-box {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 10px;
    }

    .current-image {
        width: 150px;
        height: 150px;
        border-radius: 12px;
        border: 2px dashed #ffc2d1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff0f6;
        overflow: hidden;
    }

        .current-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .upload-box {
        border: 2px dashed #ffc2d1;
        border-radius: 12px;
        padding: 20px;
        background: #fff0f6;
        flex: 1;
    }

    .buttons {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 25px;
    }

    .btn-cancel {
        border: 2px solid #d6336c;
        color: #d6336c;
        background: #fff;
        padding: 10px 22px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
    }

    .btn-save {
        background: #d6336c;
        color: white;
        border: none;
        padding: 10px 28px;
        border-radius: 12px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-save:hover {
            background: #a61e4d;
        }
</style>

<div class="edit-container">

    <div class="edit-header">
        <h2>✏️ Sửa sản phẩm</h2>
        <a href="/AdminProduct/Index" class="back-link">← Quay lại danh sách</a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">

        <input type="hidden" asp-for="ProductId" />

        <div class="form-group">
            <label>Tên sản phẩm</label>
            <input asp-for="ProductName" />
        </div>

        <div class="form-group">
            <label>Giá cơ bản (VNĐ)</label>
            <input asp-for="BasePrice" type="number" step="0.01" />
        </div>

        <div class="form-group">
            <label>Danh mục</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories"></select>
        </div>

        <div class="form-group checkbox-group">
            <input asp-for="IsActive" type="checkbox" />
            <label>Kích hoạt sản phẩm</label>
        </div>

        <div class="form-group">
            <label>Mô tả sản phẩm</label>
            <textarea asp-for="Description"></textarea>
        </div>

        <div class="form-group">
            <label>Hình ảnh sản phẩm</label>

            <div class="image-box">

                <div class="current-image">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" />
                    }
                    else
                    {
                        <span>Chưa có ảnh</span>
                    }
                </div>

                <div class="upload-box">
                    <label>Chọn ảnh mới</label>
                    <input type="file" name="imageFile" />
                    <small>PNG, JPG, JPEG</small>
                </div>
            </div>
        </div>

        <div class="buttons">
            <a href="/AdminProduct/Index" class="btn-cancel">Hủy</a>
            <button type="submit" class="btn-save">💾 Lưu thay đổi</button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
